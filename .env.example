# openGym — environment configuration template
#
# Copy this file to `.env` and adjust to taste:
#     cp .env.example .env
#
# Every variable is optional unless noted. Defaults below are what you get
# when the variable is absent or commented out.

# ──────────────────────────── Core ────────────────────────────
# Hostname passkeys are bound to. Changing it later invalidates existing
# passkeys. Use `localhost` for a purely local instance.
RP_ID=localhost

# Full URL the app is served from. Must be HTTPS for passkeys on any device
# other than localhost.
ORIGIN=http://localhost:8080

# Host port for the web UI (nginx).
WEB_PORT=8080

# Name shown in the passkey prompt.
RP_NAME=openGym

# ────────────────────────── Auth & security ──────────────────────────
# Comma-separated user ids that get the admin dashboard. *(none by default)*
# ADMIN_UIDS=

# Require an invite code to create a profile. `1` / `true` / `yes` / `on`.
# INVITE_ONLY=

# How many days a login session lasts before it expires. Baked into each
# cookie when it's issued; lowering this never cuts an existing session short.
# SESSION_DAYS=90

# ──────────────────────────── Data ────────────────────────────
# Where the api container stores users, passkeys and per-user state.
# This is set to a container path in docker-compose.yml — back it up.
DATA_DIR=/data

# Internal port the api listens on (nginx proxies to it). Do not change when
# running under docker compose.
# PORT=3000

# ───────────────────────────── Push ─────────────────────────────
# Subject line for the Web Push VAPID key (a `mailto:` or URL). VAPID keys
# themselves are generated on first run and saved to ./data/vapid.json —
# nothing to configure.
# VAPID_SUBJECT=mailto:admin@localhost

# ───────────────────────── AI coach (optional) ─────────────────────────
# The AI explainer and AI-assisted exercise creation talk to an OpenAI-
# compatible endpoint THROUGH the server — the key never reaches the browser.
#
# Without AI_API_KEY the AI features are disabled and the app falls back to
# the deterministic rule reasoning (fully functional without AI).
#
# Swap providers by changing these vars, never code. DeepSeek is the default.

# Base URL of an OpenAI-compatible API, up to but not including /chat/completions.
AI_BASE_URL=https://api.deepseek.com/v1

# Your API key. *Leave empty to disable AI features.*
AI_API_KEY=

# Model to use.
AI_MODEL=deepseek-v4-flash

# Label for logging/i18n — informational only.
# AI_PROVIDER=deepseek

# ────────────────── Frontend build-time (advanced) ──────────────────
# Dev-server proxy targets (vite.config.js). Used by `npm run dev`.
# API_TARGET=http://127.0.0.1:3000
# MEDIA_TARGET=http://127.0.0.1:8888

# Override where exercise images/GIFs load from (exercises.js). The demo /
# mobile build pulls them from a CDN instead of shipping ~140 MB.
# VITE_IMG_BASE=img/
# VITE_GIF_BASE=gif/

# Build flags.
# VITE_MOBILE=0
# VITE_DEMO=0
